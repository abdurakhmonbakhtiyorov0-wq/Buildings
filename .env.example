# Скопируйте в .env.local и вставьте ключ из Supabase: Project Settings → API Keys → anon (public).
# Без этих строк сайт работает на локальной копии data/projects.json, а заявки не сохраняются.
SUPABASE_URL=https://xyyeewtgxhaybyhixaiq.supabase.co
SUPABASE_ANON_KEY=

# Только для npm run upload-photos (загрузка фото). Секретный ключ: Project Settings → API Keys → service_role.
# Сайт его не использует; никому не показывайте и не коммитьте.
SUPABASE_SERVICE_ROLE_KEY=
